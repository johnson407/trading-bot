APP_NAME="Grid Trading Bot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trading_bot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Trading engine
TRADING_LIVE_ENABLED=false
TRADING_DEFAULT_EXCHANGE=binance
TRADING_EXCHANGES=binance
TRADING_PAPER_FEE_RATE=0
# Default per-bot evaluation interval. The `bots:dispatch` scheduler still runs
# every second as a cheap due-check; each bot is evaluated when this interval
# has elapsed.
TRADING_TICK_INTERVAL=60
TRADING_MAX_CONSECUTIVE_FAILURES=3
TRADING_RECONCILIATION_TOLERANCE=0.0001
# A bot is stale after at least this many seconds, or after its own tick
# interval plus the health-check interval when that is longer.
TRADING_STALE_TICK_SECONDS=180
TRADING_ORDER_SYNC_SECONDS=5
TRADING_HEALTH_CHECK_SECONDS=30
TRADING_BALANCE_SYNC_SECONDS=60
TRADING_EXCHANGE_TIMEOUT_MS=15000
TRADING_EXCHANGE_RATE_LIMIT_MS=1000
TRADING_EXCHANGE_MAX_RETRIES=3
TRADING_EXCHANGE_RETRY_DELAY_MS=250
TRADING_EXCHANGE_SANDBOX=false

# Go engine public market data (optional; running bot symbols are subscribed
# automatically, so ENGINE_MARKET_DATA_SYMBOLS is only an extra watchlist)
# ENGINE_MARKET_DATA_WS_URL=wss://stream.binance.com:9443/ws
# ENGINE_MARKET_DATA_REST_URL=https://api.binance.com
# ENGINE_MARKET_DATA_SYMBOLS=BTCUSDT
# Default staleness is max(15s, TRADING_TICK_INTERVAL / 2).
# ENGINE_MARKET_DATA_STALE_AFTER=15s

# Risk defaults
RISK_MAX_POSITION_NOTIONAL=1000
RISK_MAX_OPEN_ORDERS=20
RISK_DAILY_LOSS_LIMIT=100

# Alerting and retention
ALERTS_ENABLED=true
ALERTS_DEDUPE_WINDOW_SECONDS=900
ALERTS_RETENTION_DAYS=90

# Equity analytics
ANALYTICS_CAPTURE_INTERVAL_MINUTES=5
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_DEFAULT_RANGE_DAYS=30
ANALYTICS_CHART_POINTS=500
